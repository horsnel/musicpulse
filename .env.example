# ================================================================
# MusicPulse — Environment Variables
# Copy to .env.local for local development
# NEVER commit .env.local to git
# ================================================================

# ── Public (safe to expose to browser) ──────────────────────────
# Base URL for API calls from the frontend
# Leave blank in development (uses relative /api/*)
NEXT_PUBLIC_API_URL=

# ── Server-only (Workers / API routes) ──────────────────────────

# Last.fm — free API, 5 req/sec, no hard limit
# Get key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Genius — free tier, song metadata & album art
# Get token at: https://genius.com/api-clients
GENIUS_TOKEN=

# MusicBrainz — open music encyclopedia, no key needed
# Just set a descriptive user-agent
MUSICBRAINZ_USER_AGENT="MusicPulse/1.0 (your@email.com)"

# Cloudflare D1 (used by wrangler, not directly by Next.js)
# Set in wrangler.toml — do not put here

# ── Optional: enable when scaling ────────────────────────────────

# YouTube Data API — free tier: 10,000 units/day
# Get key at: https://console.cloud.google.com/
# YOUTUBE_API_KEY=

# Google Search Console — for sitemap pings
# GSC_API_KEY=

# ConvertKit — newsletter signups (free up to 1,000 subscribers)
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=

# ── Feature flags ────────────────────────────────────────────────
# Set to "false" to use mock data instead of live API calls
NEXT_PUBLIC_USE_MOCK=true
